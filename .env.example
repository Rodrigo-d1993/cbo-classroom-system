# === JWT ===
JWT_SECRET=REPLACE_WITH_BASE64_OR_LONG_RANDOM_STRING  # recommended >= 32 bytes
JWT_EXPIRATION_MS=86400000  # token expiration in milliseconds (default: 1 day)

# === MySQL ROOT ===
MYSQL_ROOT_PASSWORD=

# === ms-auth ===
AUTH_DB_NAME=db_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass
AUTH_PORT=8081
